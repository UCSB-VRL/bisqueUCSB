<?xml version="1.0" encoding="utf-8"?>
<module name="MatchAnyImagery" type="runtime">
             
     <tag name="inputs">
              
          <tag name="Input Image 1" type="resource">
               <template>
                    <tag name="label" value="Select Image 1"/>
                    <tag name="accepted_type" value="image"/>
                    <tag name="prohibit_upload" value="True"/>
               </template>
          </tag>

          <tag name="Input Image 2" type="resource">
               <template>
                    <tag name="label" value="Select Image 2"/>
                    <tag name="accepted_type" value="image"/>
                    <tag name="prohibit_upload" value="True"/>
               </template>
          </tag>

          <tag name="mex_url" type="system-input_resource"/>
          <tag name="bisque_token" type="system-input_resource"/>

     </tag>
         
     <tag name="outputs">
                  
          <tag name="NonImage">
               <tag name="Raw Matches H5" type="resource">
                    <template>
                         <tag name="label" value="Raw Matches H5"/>
                    </template>
               </tag>
                           
               <template>
                                    
                    <tag name="label" value="Outputs"/>
                                
               </template>
                       
          </tag>
              
          <tag name="Output Image" type="image">
               <template>
                    <tag name="label" value="Output Image"/>
               </template>
          </tag>
     </tag>
         
     <tag name="execute_options">
                  
          <tag name="iterable" value="image_url" type="dataset"/>
              
     </tag>
         
     <tag name="module_options">
                  
          <tag name="version" value="1"/>
              
     </tag>
         
     <tag name="display_options">
                 
          <tag name="group" value="Metadata"/>
              
     </tag>
         
     <tag name="interface">
                  
          <tag name="javascript" type="file" value="webapp.js"/>
                  
          <tag name="css" type="file" value="webapp.css"/>
              
     </tag>
         
     <tag name="help" type="file" value="public/help.html"/>
         
     <tag name="thumbnail" type="file" value="public/thumbnail.jpg"/>
            
     <tag name="title" type="string" value="MatchAnyImagery"/>
         
     <tag name="authors" type="string" value="Ali Durmaz, Charvi Mendiratta"/>
         
     <tag name="description" type="string" value="A multimodal matching module that aligns material imagery across different microscope modalities by learning shared representations."/>
</module>
