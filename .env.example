# BisQue local and Docker Compose settings.
#
# Flox copies this file to .env on first activation. Edit .env for your machine:
#   flox activate
#   just setup
#   just up
#
# Local scripts auto-load .env. Values already exported in your shell take
# precedence over this file. Docker Compose reads the same .env for variable
# interpolation and injects it into the BisQue container. Compose intentionally
# overrides container filesystem paths and the in-container port for safety.
# Kubernetes/k3s uses deploy/k3s/10-configmap.yaml and 11-secret.yaml instead.

# Local server bind/public URL.
BISQUE_HTTP_HOST=0.0.0.0
BISQUE_HTTP_PORT=8080
# Leave unset for Docker Compose so module callbacks use host.docker.internal.
# For direct local runs, unset defaults to http://localhost:<BISQUE_HTTP_PORT>.
# BISQUE_PUBLIC_URL=http://localhost:8080
# Docker Compose rewrites internal module URLs to this host-reachable callback.
# BISQUE_DOCKER_CALLBACK_URL=http://host.docker.internal:8080

# Runtime state. Keep this inside the checkout for normal development.
BISQUE_RUNTIME_DIR=.bisque
# Advanced: override only when runtime subdirectories need to live elsewhere.
# Docker Compose ignores these host paths and uses /app/.bisque for mutable
# runtime state. Compose and k3s set BISQUE_PUBLIC_DIR=/app/public because
# container static asset links are baked into the image.
# BISQUE_CONFIG_DIR=.bisque/config
# BISQUE_DATA_DIR=.bisque/data
# BISQUE_EXTERNAL_DIR=.bisque/external
# BISQUE_PUBLIC_DIR=.bisque/public
# BISQUE_REPORTS_DIR=.bisque/reports
# BISQUE_STAGING_DIR=.bisque/staging
# BISQUE_LOG_DIR=.bisque/logs
# BISQUE_RUN_DIR=.bisque/run

# Database. Local development defaults to SQLite when BISQUE_DBURL is unset.
# Docker Compose overrides this to use its Postgres service by default.
# BISQUE_DBURL=sqlite:///.bisque/data/bisque.db
# BISQUE_DBURL=postgresql://bisque:bisque@localhost:5432/bisque

# Secrets. Replace this in real deployments. Do not commit real secrets.
BISQUE_SECRET=change-me

# Site metadata.
BISQUE_ORGANIZATION="Your Organization"
BISQUE_TITLE="BisQue Image Repository"
BISQUE_ADMIN_EMAIL=admin@example.com

# Service loading.
# The default runs engine_service in the main web process so local module
# discovery and dispatch work without a separate engine server.
BISQUE_ENABLE_ENGINE_SERVICE=true
# Advanced: override the exact legacy service lists.
# BISQUE_SERVICES_ENABLED=
# BISQUE_SERVICES_DISABLED=

# Module/runtime defaults.
# Leave empty for local module images such as edgedetection:v1.0.0.
# Set to a registry host when module images should be pulled from a registry.
BISQUE_DOCKER_HUB=
BISQUE_MODULE_DIRS=source/modules
BISQUE_DOCKER_BACKEND=docker
# BISQUE_ARGO_WORKFLOW_TEMPLATE=bqflow-module-template
# BISQUE_ARGO_GPU_WORKFLOW_TEMPLATE=bqflow-module-gpu-template

# Optional upload handoff directory, mainly for nginx/container uploads.
# BISQUE_UPLOAD_TMP_DIR=.bisque/upload-tmp

# Debug/front-end asset behavior.
# Direct local runs default to debug/development when unset. Docker Compose and
# k3s set deployment-oriented defaults explicitly.
# BISQUE_DEBUG=true
# BISQUE_JS_ENVIRONMENT=development

# Optional SMTP/registration settings.
BISQUE_SMTP_HOST=localhost
BISQUE_SMTP_PORT=587
BISQUE_SMTP_USER=
BISQUE_SMTP_PASSWORD=
BISQUE_SMTP_TLS=true
BISQUE_SMTP_SSL=false
BISQUE_SMTP_TIMEOUT=30
BISQUE_MAIL_FROM=noreply@localhost
BISQUE_MAIL_FROM_NAME="Bisque System"
BISQUE_EMAIL_VERIFICATION_ENABLED=false

# Optional test fixture override.
# BISQUE_TEST_INPUT_DIR=source/bqapi/bqapi/tests/fixtures

# Docker Compose Postgres defaults.
POSTGRES_DB=bisque
POSTGRES_USER=bisque
POSTGRES_PASSWORD=bisque
